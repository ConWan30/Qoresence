<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Deck is local-first HTTP on LAN. Same-Wi-Fi only; not a public stream. -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
