# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
.venv/
venv/
env/
.env

# Distribution / packaging
dist/
build/
*.egg-info/

# IDE / editor
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Logs
*.log
logs/

# Local HDMI clips (capture-card exports) and generated reels
clips/
reels/

# Local data (never commit)
sessions/
*.db
*.sqlite

# Eye-check snapshots
eye_check_*.png

# Coverage
.coverage
htmlcov/
.pytest_cache/

# Type checking
.mypy_cache/

# Temporary files
*.tmp
*.temp

# Auto-downloaded vision models and learning data
models/
game_detection_learning.jsonl

# Twitch / API tokens and secrets (never commit)
*_token*.txt
*_oauth*.txt
*.secret
.env.local
.secrets
data/

# Quicksilver / LLM dedicated API (never commit)
*.key
*.key.*
.secrets/
.secrets/**
.playwright-mcp/

# Native Glass app (Capacitor / Android) build artifacts.
# The native/android/ project source IS committed (Capacitor convention); its
# own .gitignore handles gradle/build outputs. Ignore node deps + APKs here.
native/node_modules/
*.apk
*.aab
